{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.internal/schemas/capability-contract-v1.json",
  "title": "NEXORA Capability Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "version",
    "scope",
    "policy_version",
    "evidence_refs",
    "baseline",
    "effect",
    "retention",
    "generalization",
    "interference",
    "cost",
    "limitations",
    "validity",
    "provenance"
  ],
  "properties": {
    "capability_id": {"type": "string", "minLength": 1},
    "version": {"const": "1.0"},
    "scope": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "evaluation_distribution"],
      "properties": {
        "metric": {"type": "string"},
        "value": {"type": "number"},
        "evaluation_distribution": {"type": "string"}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "estimate", "decision_threshold", "status"],
      "properties": {
        "metric": {"type": "string"},
        "estimate": {"type": ["number", "null"]},
        "interval": {"type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "decision_threshold": {"type": "number"},
        "status": {"enum": ["PASS", "FAIL", "HOLD", "UNKNOWN", "NOT_IDENTIFIABLE"]}
      }
    },
    "retention": {"$ref": "#/$defs/assessment"},
    "generalization": {"$ref": "#/$defs/assessment"},
    "interference": {"$ref": "#/$defs/assessment"},
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "selection", "verification", "transfer", "application", "human", "compute", "recovery", "unit"],
      "properties": {
        "production": {"type": "number", "minimum": 0},
        "selection": {"type": "number", "minimum": 0},
        "verification": {"type": "number", "minimum": 0},
        "transfer": {"type": "number", "minimum": 0},
        "application": {"type": "number", "minimum": 0},
        "human": {"type": "number", "minimum": 0},
        "compute": {"type": "number", "minimum": 0},
        "recovery": {"type": "number", "minimum": 0},
        "unit": {"type": "string"}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evaluated_at"],
      "properties": {
        "status": {"enum": ["VALID", "INVALID", "HOLD", "UNKNOWN", "EXPIRED"]},
        "evaluated_at": {"type": "string"},
        "expires_at": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_experience_ids", "lineage_hashes"],
      "properties": {
        "source_experience_ids": {"type": "array", "items": {"type": "string"}},
        "lineage_hashes": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "metric", "value"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "HOLD", "UNKNOWN", "NOT_IDENTIFIABLE"]},
        "metric": {"type": "string"},
        "value": {"type": ["number", "null"]},
        "notes": {"type": "string"}
      }
    }
  }
}
