{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Edit(./sources/**)",
      "Edit(sources/**)",
      "Edit(./.claude/**)",
      "Edit(.claude/**)",
      "Edit(./CLAUDE.md)",
      "Edit(CLAUDE.md)",
      "Edit(./control/AUTHORITY.md)",
      "Edit(control/AUTHORITY.md)",
      "Write(./sources/**)",
      "Write(sources/**)",
      "Write(./.claude/**)",
      "Write(.claude/**)",
      "Write(./CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Write(./control/AUTHORITY.md)",
      "Write(control/AUTHORITY.md)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh:*)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
